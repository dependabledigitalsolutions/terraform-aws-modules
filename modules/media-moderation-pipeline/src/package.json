{
  "name": "@dds/media-moderation-pipeline-lambdas",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "build:sign-upload":        "esbuild sign-upload/handler.ts        --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/sign-upload/index.mjs        --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:finalize-upload":    "esbuild finalize-upload/handler.ts    --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/finalize-upload/index.mjs    --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:slack-interaction":  "esbuild slack-interaction/handler.ts  --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/slack-interaction/index.mjs  --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:transcode-complete": "esbuild transcode-complete/handler.ts --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/transcode-complete/index.mjs --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:list-content":       "esbuild list-content/handler.ts       --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/list-content/index.mjs       --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:ingest-url":         "esbuild ingest-url/handler.ts         --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/ingest-url/index.mjs         --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build:cron-cleanup":       "esbuild cron-cleanup/handler.ts       --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --external:sharp --outfile=../dist/cron-cleanup/index.mjs       --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "build": "npm run build:sign-upload && npm run build:finalize-upload && npm run build:slack-interaction && npm run build:transcode-complete && npm run build:list-content && npm run build:ingest-url && npm run build:cron-cleanup"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.654.0",
    "@aws-sdk/client-dynamodb": "^3.654.0",
    "@aws-sdk/client-mediaconvert": "^3.654.0",
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/client-secrets-manager": "^3.654.0",
    "@aws-sdk/client-sqs": "^3.654.0",
    "@aws-sdk/lib-dynamodb": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "@aws-sdk/util-dynamodb": "^3.654.0",
    "jose": "^5.9.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
